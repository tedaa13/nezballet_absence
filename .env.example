# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/absensi?schema=public"
# Non-pooled connection used by `prisma migrate` (Neon: same URL without "-pooler"; locally: same as DATABASE_URL)
DIRECT_URL="postgresql://user:password@localhost:5432/absensi?schema=public"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Public base URL used to build the QR scan links (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Studio timezone for schedule/attendance logic (server runs in UTC on Vercel)
APP_TIMEZONE="Asia/Jakarta"
